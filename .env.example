# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dsa_revision"

# Auth.js secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me"

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/notifications (Vercel sends this automatically when CRON_SECRET is set)
CRON_SECRET=""

# Email digest (Resend). Leave empty to disable email sending.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="DSA Revise <onboarding@resend.dev>"
